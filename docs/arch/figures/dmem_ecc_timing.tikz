\begin{tikzpicture}[
  >= {Stealth[length=2.3mm, width=1.65mm]},
  blk/.style={
    draw=black,
    line width=1.05pt,
    rounded corners=4.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=3pt
  },
  subblk/.style={
    draw=black,
    line width=0.95pt,
    rounded corners=3.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=2.5pt
  },
  container/.style={
    draw=black,
    line width=1.2pt,
    rounded corners=6.5pt,
    inner sep=0pt
  },
  sig/.style={
    ->,
    draw=black,
    line width=0.95pt
  },
  bisig/.style={
    <->,
    draw=black,
    line width=0.95pt
  },
  tick/.style={
    draw=black,
    line width=0.95pt
  },
  lbl/.style={
    font=\scriptsize\bfseries,
    text=black,
    inner sep=1.5pt
  },
  wav/.style={
    draw=black,
    line width=1.05pt
  },
  busseg/.style={
    draw=black,
    line width=0.90pt,
    align=center,
    text=black,
    font=\fontsize{5.8}{6.8}\selectfont
  }
]

% ==============================================================================
% 0. Cabecera
% ==============================================================================
\node[font=\huge\bfseries] at (12.50, 17.90)
  {SHRV32 -- Interfaz y Diagrama Temporal DMEM ECC};

% ==============================================================================
% 1. Mitad Superior: Arquitectura de Interfaz y Backend Dual (y = 9.45 .. 17.25)
% ==============================================================================

% --- Etapa Izquierda: Bus Harvard y Telemetría (soc.v, x = 0.00 .. 5.75) ---
\node[container, fill=gray!8, minimum width=5.75cm, minimum height=7.80cm]
  (soc_if_box) at (2.875, 13.35) {};
\node[font=\small\bfseries] at (2.875, 16.92)
  {Bus Harvard \& Telemetría (soc.v)};

\node[blk, fill=orange!62, minimum width=5.15cm, minimum height=1.65cm]
  (dmem_dec_blk) at (2.875, 15.65)
  {\textbf{Decodificador dmem\_sel \& W\^{}X}\\\fontsize{6.0}{7.3}\selectfont \texttt{dmem\_range}: \texttt{0x0000\_2000--3FFF} (8 KB)\\\fontsize{6.0}{7.3}\selectfont \texttt{dmem\_sel = mem\_valid \&\& dmem\_range \&\& !instr}\\\fontsize{6.0}{7.3}\selectfont \texttt{wstrb\_i = fault ? 4'b0 : mem\_wstrb}};

\node[blk, fill=yellow!35, minimum width=5.15cm, minimum height=1.55cm]
  (dmem_if_blk) at (2.875, 13.70)
  {\textbf{Interfaz Nativa hacia dmem}\\\fontsize{6.0}{7.3}\selectfont \texttt{valid\_i, wstrb\_i, addr\_i, wdata\_i}\\\fontsize{6.0}{7.3}\selectfont $\leftarrow$ \texttt{rdata\_o[31:0], ready\_o}};

\node[blk, fill=orange!62, minimum width=5.15cm, minimum height=1.50cm]
  (dmem_tel_blk) at (2.875, 11.80)
  {\textbf{Registros Telemetría ECC (MMIO R/O)}\\\fontsize{6.0}{7.3}\selectfont \texttt{dmem\_sbe} $\rightarrow$ \texttt{dmem\_sbu} (\texttt{0x3000\_0008})\\\fontsize{6.0}{7.3}\selectfont \texttt{dmem\_dbe} $\rightarrow$ \texttt{dmem\_dbu} (\texttt{0x3000\_000C})};

\node[blk, fill=gray!35, minimum width=5.15cm, minimum height=0.86cm]
  (dmem_trap_blk) at (2.875, 10.22)
  {\textbf{Trap Fatal (ecc\_fault\_r $\rightarrow$ LED15)}\\\fontsize{6.0}{7.3}\selectfont \texttt{if (imem\_dbe || dmem\_dbe) ecc\_fault\_r <= 1}};

\draw[sig] (dmem_dec_blk.south) -- (dmem_if_blk.north);
\draw[sig] (dmem_tel_blk.south) -- (dmem_trap_blk.north);

% --- Etapa Central: Controlador bram_ecc.v (x = 7.45 .. 16.05) ---
\node[container, fill=gray!8, minimum width=8.60cm, minimum height=7.80cm]
  (ctrl_ecc_box) at (11.75, 13.35) {};
\node[font=\small] at (11.75, 16.92)
  {\textbf{Controlador bram\_ecc.v} \scriptsize (5 Estados $\cdot$ RMW $\cdot$ Auto-Scrubbing)};

\node[blk, fill=violet!32, minimum width=8.05cm, minimum height=2.92cm]
  (fsm_blk) at (11.75, 15.05)
  {\textbf{FSM Síncrona (state[2:0])}\\\fontsize{6.0}{7.3}\selectfont \textbf{ST\_IDLE (0):} \texttt{sw} (1c) $\rightarrow$ \texttt{ready\_o=1} | \texttt{lw} $\rightarrow$ \texttt{ST\_READ}\\\fontsize{6.0}{7.3}\selectfont \phantom{\textbf{ST\_IDLE (0):}} \texttt{sb/sh} parcial $\rightarrow$ \texttt{ST\_RMW\_READ}\\\fontsize{6.0}{7.3}\selectfont \textbf{ST\_READ (1):} \texttt{rdata\_o <= dec\_data}; \texttt{DBE} $\rightarrow$ \texttt{dbe\_o=1, ready\_o=1};\\\fontsize{6.0}{7.3}\selectfont \phantom{\textbf{ST\_READ (1):}} \texttt{SBE} $\rightarrow$ \texttt{sbe\_o=1, ST\_SCRUB}; limpio $\rightarrow$ \texttt{ready\_o=1}\\\fontsize{6.0}{7.3}\selectfont \textbf{ST\_SCRUB (2):} reescribe \texttt{scrub\_word\_q} (\texttt{bram\_we=1}) $\rightarrow$ \texttt{ready\_o=1}\\\fontsize{6.0}{7.3}\selectfont \textbf{ST\_RMW\_READ (3) $\rightarrow$ ST\_RMW\_WRITE (4):} captura \texttt{rmw\_base\_q}, aborta \texttt{DBE}};

\node[blk, fill=blue!28, minimum width=3.90cm, minimum height=1.50cm]
  (rmw_blk) at (9.675, 12.35)
  {\textbf{Mezcla RMW (sb/sh)}\\\fontsize{6.0}{7.3}\selectfont \texttt{rmw\_merged\_data[31:0]}\\\fontsize{6.0}{7.3}\selectfont mezcla bytes por \texttt{wstrb\_q}\\\fontsize{6.0}{7.3}\selectfont sobre \texttt{rmw\_base\_q} saneado};

\node[blk, fill=yellow!35, minimum width=3.90cm, minimum height=1.50cm]
  (regs_blk) at (13.825, 12.35)
  {\textbf{Registros Canal ECC}\\\fontsize{6.0}{7.3}\selectfont \texttt{rdata\_o[31:0]} (aísla camino)\\\fontsize{6.0}{7.3}\selectfont \texttt{scrub\_word\_q[38:0]=\{ecc,d\}}\\\fontsize{6.0}{7.3}\selectfont \texttt{addr\_q, wstrb\_q, wdata\_q}};

\node[blk, fill=yellow!18, minimum width=8.05cm, minimum height=1.32cm]
  (mux_blk) at (11.75, 10.42)
  {\textbf{Mux Combinacional hacia BRAM (always @*)}\\\fontsize{6.0}{7.3}\selectfont Genera \texttt{bram\_en, bram\_we, bram\_addr[10:0], bram\_wdata[38:0]}\\\fontsize{6.0}{7.3}\selectfont Selecciona origen: \texttt{enc\_word} (\texttt{sw}/RMW) o \texttt{scrub\_word\_q} (\texttt{ST\_SCRUB})};

\draw[bisig] (9.675, 13.59) -- (rmw_blk.north);
\draw[bisig] (13.825, 13.59) -- (regs_blk.north);
\draw[sig] (rmw_blk.south) -- (9.675, 11.08);
\draw[sig] (regs_blk.south) -- (13.825, 11.08);

% --- Etapa Derecha: Backend Dual de Memoria Física (x = 17.65 .. 25.00) ---
\node[container, fill=gray!8, minimum width=7.35cm, minimum height=7.80cm]
  (backend_box) at (21.325, 13.35) {};
\node[font=\small] at (21.325, 16.92)
  {\textbf{Backend Dual} \scriptsize (\texttt{generate} $\cdot$ \texttt{VIVADO\_ECC\_IP})};

\node[blk, fill=green!42, minimum width=6.80cm, minimum height=2.90cm]
  (rama_a_blk) at (21.325, 15.00)
  {\textbf{Rama A: RTL Portable (Sim / openXC7 / PolarFire)}\\\fontsize{6.0}{7.3}\selectfont \textbf{1. ecc\_secded\_enc:} Hsiao (39,32), 13--14 XOR/fila (0$\rightarrow$0)\\\fontsize{6.0}{7.3}\selectfont \textbf{2. bram\_sp (2048$\times$39b):} \texttt{BYTE\_WRITE=0}, \texttt{USE\_INIT=0}\\\fontsize{6.0}{7.3}\selectfont \phantom{\textbf{2. bram\_sp:}} 2$\times$\texttt{RAMB36E1} + 1$\times$\texttt{RAMB18E1} (Artix-7)\\\fontsize{6.0}{7.3}\selectfont \textbf{3. ecc\_secded\_dec:} síndrome 7b $\rightarrow$ \texttt{dec\_data, dec\_ecc, sbe/dbe}};

\node[blk, fill=green!42, minimum width=6.80cm, minimum height=3.20cm]
  (rama_b_blk) at (21.325, 11.35)
  {\textbf{Rama B: IP Vivado (sources\_1 con VIVADO\_ECC\_IP=1)}\\\fontsize{6.0}{7.3}\selectfont \textbf{blk\_mem\_gen\_dmem\_ecc} (Simple Dual-Port, 2048$\times$32b)\\\fontsize{6.0}{7.3}\selectfont \texttt{CONFIG.ECC \{false\}}, \texttt{ecctype \{Soft\_ECC\}}, \texttt{softecc \{true\}}\\\fontsize{6.0}{7.3}\selectfont Puerto A (Write): \texttt{ena = bram\_en \&\& bram\_we, wea, addra, dina}\\\fontsize{6.0}{7.3}\selectfont Puerto B (Read): \texttt{enb = bram\_en \&\& !bram\_we, addrb, doutb}\\\fontsize{6.0}{7.3}\selectfont Banderas: \texttt{.sbiterr(dec\_sbiterr), .dbiterr(dec\_dbiterr)}};

% --- Conexiones entre Etapas Superiores (corredores de 1.70 y 1.60 cm, cero cruces) ---
\draw[sig] (dmem_if_blk.east |- 0,14.32) -- (fsm_blk.west |- 0,14.32);
\node[lbl, align=center] at (6.60, 14.68) {\fontsize{5.6}{6.6}\selectfont valid, wstrb\\addr, wdata};

\draw[sig] (fsm_blk.west |- 0,13.94) -- (dmem_if_blk.east |- 0,13.94);
\node[lbl, align=center] at (6.46, 13.56) {\fontsize{5.6}{6.6}\selectfont rdata\_o\\ready\_o};

\draw[sig] (8.00, 13.59) -- (8.00, 13.22) -- (7.02, 13.22) -- (7.02, 11.80) -- (dmem_tel_blk.east);
\node[lbl, align=center] at (6.38, 12.48) {\fontsize{5.6}{6.6}\selectfont sbe\_o\\dbe\_o};

\draw[sig] (backend_box.west |- 0,15.05) -- (fsm_blk.east |- 0,15.05);
\node[lbl, align=center] at (16.85, 15.42) {\fontsize{5.6}{6.6}\selectfont dec\_data\\sbe / dbe};

\draw[sig] (mux_blk.east) -- (backend_box.west |- 0,10.42);
\node[lbl, align=center] at (16.85, 10.82) {\fontsize{5.6}{6.6}\selectfont en, we\\addr, wdata};

