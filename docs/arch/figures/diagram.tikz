\draw[sig] (22.55, 3.18) -- (22.55, 4.225);
\draw[tick] (22.46, 3.58) -- (22.64, 3.82);
\node[lbl, align=center] at (23.60, 3.70) {rdata/ready\\sbe/dbe};

% ==============================================================================
% 5. Nivel G: Pines Físicos Nexys A7-100T y Backend / Precarga (Gris)
% ==============================================================================
\node[blk, fill=gray!35, minimum width=3.70cm, minimum height=0.84cm]
  (pins_leds) at (8.00, 0.75)
  {\textbf{LEDs Usuario [14:0]}\\\scriptsize Nexys A7 Pins H17--V12};

\node[blk, fill=gray!35, minimum width=4.00cm, minimum height=0.84cm]
  (pins_uart) at (12.15, 0.75)
  {\textbf{USB-UART FT2232HQ}\\\scriptsize ser\_tx (D4) \quad|\quad ser\_rx (C4)};

\node[blk, fill=gray!35, minimum width=4.45cm, minimum height=0.84cm]
  (fw_init) at (16.675, 0.75)
  {\textbf{build/firmware.hex (39b)}\\\scriptsize \$readmemh $\cdot$ makehex.py --ecc};

\node[blk, fill=gray!35, minimum width=4.45cm, minimum height=0.84cm]
  (dmem_backend) at (21.425, 0.75)
  {\textbf{Backend Dual + crt0.S}\\\scriptsize RTL 39b bram\_sp | Vivado Soft ECC IP};

\draw[sig] (leds_blk.south) -- (pins_leds.north);
