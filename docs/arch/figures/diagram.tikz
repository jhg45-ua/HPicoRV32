\begin{tikzpicture}[
  >= {Stealth[length=2.3mm, width=1.65mm]},
  blk/.style={
    draw=black,
    line width=1.05pt,
    rounded corners=4.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=3pt
  },
  subblk/.style={
    draw=black,
    line width=0.95pt,
    rounded corners=3.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=2.5pt
  },
  container/.style={
    draw=black,
    line width=1.1pt,
    rounded corners=6.5pt
  },
  sig/.style={
    ->,
    draw=black,
    line width=0.95pt
  },
  bisig/.style={
    <->,
    draw=black,
    line width=0.95pt
  },
  tick/.style={
    draw=black,
    line width=0.95pt
  },
  lbl/.style={
    font=\scriptsize\bfseries,
    text=black,
    inner sep=1.5pt
  }
]

% ==============================================================================
% 0. Cabecera
% ==============================================================================
\node[font=\normalsize\bfseries] at (2.05, 18.00)
  {\textcolor{red!70!black}{SHRV32} - 2026};
\node[font=\huge\bfseries] at (12.05, 17.95)
  {SHRV32};
\node[font=\normalsize\bfseries] at (12.05, 17.30)
  {Baseline SoC Architecture Block Diagram (Hito 0)};
\node[font=\normalsize\bfseries] at (21.30, 18.00)
  {Nexys A7-100T $\cdot$ xc7a100t};

% ==============================================================================
% 1. Columna Izquierda: Clock & POR + Trap + Leyenda / Métricas
% ==============================================================================

% --- Contenedor Clock & Power-On Reset (soc.v) ---
\draw[container, fill=violet!32] (0.30, 10.65) rectangle (3.80, 16.40);
\node[font=\small\bfseries] at (2.05, 16.00)
  {Clock \& POR (soc.v)};

\node[subblk, fill=violet!18, minimum width=2.95cm, minimum height=0.90cm]
  (clk_in) at (2.05, 15.05)
  {\textbf{clk (100 MHz)}\\\scriptsize Nexys A7 Pin E3};

\node[subblk, fill=violet!18, minimum width=2.95cm, minimum height=0.90cm]
  (rst_in) at (2.05, 13.85)
  {\textbf{resetn (CPU\_RESETN)}\\\scriptsize Pin C12 $\cdot$ Activo bajo};

\node[subblk, fill=violet!18, minimum width=2.95cm, minimum height=0.95cm]
  (por_cnt) at (2.05, 12.60)
  {\textbf{POR Counter}\\\scriptsize reset\_cnt[5:0] (63 ciclos)};

\node[subblk, fill=violet!18, minimum width=2.95cm, minimum height=0.90cm]
  (sys_rst) at (2.05, 11.35)
  {\textbf{sys\_resetn}\\\scriptsize = \&reset\_cnt};

\draw[sig] (rst_in.south) -- (por_cnt.north);
\draw[sig] (por_cnt.south) -- (sys_rst.north);

% --- Indicador de Trampa (LED15) ---
\node[blk, fill=gray!35, minimum width=3.50cm, minimum height=1.35cm]
  (trap_blk) at (2.05, 8.15)
  {\textbf{Trap Indicator}\\\scriptsize trap $\rightarrow$ LED15 (Pin V11)\\\scriptsize ILLINSN $\cdot$ MISALIGN};

% --- Leyenda de Niveles y Métricas Base (Vivado impl_1) ---
\draw[container, fill=gray!4] (0.30, 0.33) rectangle (3.80, 6.20);
\node[font=\footnotesize\bfseries] at (2.05, 5.82)
  {Leyenda y Métricas (Hito 0)};
\draw[line width=0.6pt, gray!60] (0.52, 5.55) -- (3.58, 5.55);

\draw[fill=violet!32, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 5.06) rectangle (0.92, 5.30);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 5.18) {Front-End $\cdot$ Control $\cdot$ POR};

\draw[fill=orange!62, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 4.60) rectangle (0.92, 4.84);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 4.72) {Decode $\cdot$ Counters};

\draw[fill=yellow!35, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 4.14) rectangle (0.92, 4.38);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 4.26) {Regfile $\cdot$ SoC Bus};

\draw[fill=blue!28, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 3.68) rectangle (0.92, 3.92);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 3.80) {Execution $\cdot$ Mem IF};

\draw[fill=green!42, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 3.22) rectangle (0.92, 3.46);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 3.34) {BRAM $\cdot$ Periféricos};

\draw[fill=gray!35, draw=black, line width=0.7pt, rounded corners=1.5pt] (0.54, 2.76) rectangle (0.92, 3.00);
\node[font=\scriptsize\bfseries, text width=2.45cm, align=left] at (2.32, 2.88) {I/O Física $\cdot$ Estado};

\draw[line width=0.6pt, gray!60] (0.52, 2.54) -- (3.58, 2.54);
\node[font=\footnotesize\bfseries] at (2.05, 2.30)
  {Vivado impl\_1 (xc7a100t)};
\node[align=center, font=\scriptsize] at (2.05, 1.22)
  {\textbf{LUTs:} 1\,114 (1.76\%)\\
   \textbf{FFs:} 703 (0.55\%)\\
   \textbf{BRAM:} 4 $\times$ RAMB36E1 (16 KB)\\
   \textbf{WNS (100 MHz):} +3.531 ns\\
   \textbf{Fmax est.:} $\approx$ 154.6 MHz};

% ==============================================================================
% 2. Núcleo PicoRV32 (rtl/core/picorv32.v)
% ==============================================================================
\draw[container, fill=gray!6] (5.20, 6.75) rectangle (23.80, 16.40);
\node[font=\small] at (14.50, 16.08)
  {\textbf{Core: picorv32} \scriptsize (RV32I $\cdot$ COMPRESSED\_ISA=0 $\cdot$ rtl/core/picorv32.v)};

% --- Nivel A: Front-End & Control (Morado) ---
\node[blk, fill=violet!32, minimum width=5.15cm, minimum height=1.15cm]
  (pc_unit) at (8.25, 14.50)
  {\textbf{Program Counter}\\\scriptsize reg\_pc[31:0] $\cdot$ reg\_next\_pc[31:0]};

\node[blk, fill=violet!32, minimum width=5.10cm, minimum height=1.15cm]
  (fetch_unit) at (14.30, 14.50)
  {\textbf{Instruction Fetch / Latch}\\\scriptsize mem\_rdata\_latched $\cdot$ mem\_do\_rinst};

\node[blk, fill=violet!32, minimum width=5.15cm, minimum height=1.15cm]
  (ctrl_fsm) at (20.25, 14.50)
  {\textbf{Control FSM (cpu\_state[7:0])}\\\scriptsize fetch $\cdot$ ld\_rs1/2 $\cdot$ exec $\cdot$ mem $\cdot$ trap};

% --- Nivel B: Decode & Counters (Naranja) ---
\node[blk, fill=orange!62, minimum width=10.10cm, minimum height=1.15cm]
  (decoder) at (10.70, 12.60)
  {\textbf{RV32I Instruction Decoder}\\\scriptsize instr\_* $\cdot$ CATCH\_ILLINSN=1 $\cdot$ CATCH\_MISALIGN=1};

\node[blk, fill=orange!62, minimum width=6.20cm, minimum height=1.15cm]
  (counters) at (19.70, 12.60)
  {\textbf{Hardware Counters (32b)}\\\scriptsize count\_cycle $\cdot$ count\_instr $\cdot$ ENABLE\_COUNTERS=1};

% --- Nivel C: Register File & Operands (Amarillo) ---
\node[blk, fill=yellow!35, minimum width=10.10cm, minimum height=1.25cm]
  (regfile) at (10.70, 10.60)
  {\textbf{Register File (cpuregs[0:31])}\\\scriptsize 32 $\times$ 32b Dual-Port LUTRAM $\cdot$ REGS\_INIT\_ZERO=1};

\node[blk, fill=yellow!35, minimum width=6.20cm, minimum height=1.25cm]
  (op_regs) at (19.70, 10.60)
  {\textbf{Operand \& Writeback Regs}\\\scriptsize reg\_op1 $\cdot$ reg\_op2 $\cdot$ reg\_out (32b)};

% --- Nivel D: Execution & Memory Interface (Azul) ---
\node[blk, fill=blue!28, minimum width=5.40cm, minimum height=1.35cm]
  (alu) at (8.35, 8.10)
  {\textbf{ALU (Combinational)}\\\scriptsize ADD/SUB $\cdot$ Logic $\cdot$ Compare\\\scriptsize alu\_out $\rightarrow$ alu\_out\_q (32b)};

\node[blk, fill=blue!28, minimum width=5.10cm, minimum height=1.35cm]
  (shifter) at (14.30, 8.10)
  {\textbf{Barrel Shifter (1-Cycle)}\\\scriptsize SLL $\cdot$ SRL $\cdot$ SRA (32b)\\\scriptsize BARREL\_SHIFTER=1};

\node[blk, fill=blue!28, minimum width=5.15cm, minimum height=1.35cm]
  (mem_if) at (20.25, 8.10)
  {\textbf{Native Memory Interface}\\\scriptsize mem\_state[1:0] $\cdot$ Valid/Ready\\\scriptsize mem\_valid $\cdot$ mem\_instr $\cdot$ mem\_wstrb};

% --- Conexiones internas de picorv32 ---
\draw[bisig] (pc_unit.east) -- (fetch_unit.west);
\draw[sig] (fetch_unit.east) -- (ctrl_fsm.west);

\draw[sig] (13.20, 13.925) -- (13.20, 13.175);
\draw[tick] (13.11, 13.43) -- (13.29, 13.67);
\node[lbl] at (14.05, 13.55) {32b (insn)};

\draw[sig] (20.25, 13.925) -- (20.25, 13.175);

\draw[sig] (10.70, 12.025) -- (10.70, 11.225);
\draw[tick] (10.61, 11.51) -- (10.79, 11.75);
\node[lbl] at (11.78, 11.63) {5b (rs1/rs2/rd)};

\draw[sig] (19.70, 12.025) -- (19.70, 11.225);
\draw[tick] (19.61, 11.51) -- (19.79, 11.75);
\node[lbl] at (20.15, 11.63) {32b};

\draw[sig] (regfile.east) -- (op_regs.west);
\draw[tick] (16.09, 10.48) -- (16.27, 10.72);
\node[lbl] at (16.18, 10.95) {2$\times$32b};

% Operandos -> ALU y Barrel Shifter
\draw[sig] (18.00, 9.975) -- (18.00, 9.38) -- (9.85, 9.38) -- (9.85, 8.775);
\draw[sig] (14.30, 9.38) -- (shifter.north);
\fill[black] (14.30, 9.38) circle (0.055);
\draw[tick] (16.01, 9.26) -- (16.19, 9.50);
\node[lbl] at (16.10, 9.68) {32b (reg\_op1/2)};

% Shifter -> ALU y ALU writeback -> Regfile
\draw[sig] (shifter.west) -- (alu.east);
\draw[sig] (7.10, 8.775) -- (7.10, 9.975);
\draw[tick] (7.01, 9.26) -- (7.19, 9.50);
\node[lbl] at (6.30, 9.38) {32b (wb)};

% Operandos / Carga <-> Interfaz de memoria
\draw[sig] (19.60, 9.975) -- (19.60, 8.775);
\draw[tick] (19.51, 9.26) -- (19.69, 9.50);
\node[lbl] at (19.08, 9.38) {32b};

\draw[sig] (21.50, 8.775) -- (21.50, 9.975);
\draw[tick] (21.41, 9.26) -- (21.59, 9.50);
\node[lbl] at (22.02, 9.38) {32b};

% Retorno de instrucción capturada (mem_instr) hacia Fetch
\draw[sig] (mem_if.east) -- (23.35, 8.10) -- (23.35, 15.52) -- (14.30, 15.52) -- (fetch_unit.north);
\draw[tick] (23.26, 11.68) -- (23.44, 11.92);
\node[lbl] at (22.92, 11.80) {32b};
\node[lbl] at (18.80, 15.72) {mem\_rdata (mem\_instr=1)};

% --- Conexiones Core <-> Columna Izquierda ---
\draw[sig] (3.80, 14.85) -- (5.20, 14.85);
\node[lbl] at (4.50, 15.08) {clk};

\draw[sig] (3.80, 11.35) -- (5.20, 11.35);
\node[lbl] at (4.50, 11.58) {sys\_resetn};

\draw[sig] (5.20, 8.15) -- (trap_blk.east);
\node[lbl] at (4.50, 8.38) {trap};

% ==============================================================================
% 3. Nivel E: Bus Nativo SoC y Decodificador de Direcciones (soc.v)
% ==============================================================================
\node[blk, fill=orange!62, minimum width=5.40cm, minimum height=1.35cm]
  (addr_dec) at (8.35, 4.90)
  {\textbf{Address Decoder (Comb.)}\\\scriptsize ram\_sel: 0x0000\_0000--3FFF\\\scriptsize leds: 0x1000\_0000 $\cdot$ uart: 0x2000\_0004/8};

\node[blk, fill=yellow!35, minimum width=5.10cm, minimum height=1.35cm]
  (bus_ctrl) at (14.30, 4.90)
  {\textbf{Bus Controller (Sync.)}\\\scriptsize mem\_ready (1 cyc) $\cdot$ ram\_read\_r\\\scriptsize mmio\_rdata[31:0] $\cdot$ UART Stall};

\node[blk, fill=yellow!18, minimum width=5.15cm, minimum height=1.35cm]
  (rdata_mux) at (20.25, 4.90)
  {\textbf{Read Data Mux}\\\scriptsize mem\_rdata = ram\_read\_r\\\scriptsize ? ram\_rdata : mmio\_rdata};

% Conexiones Core <-> Nivel E (sin cruces)
\draw[sig] (18.20, 7.425) -- (18.20, 6.20) -- (8.35, 6.20) -- (addr_dec.north);
\draw[sig] (14.30, 6.20) -- (bus_ctrl.north);
\fill[black] (14.30, 6.20) circle (0.055);
\draw[tick] (11.21, 6.08) -- (11.39, 6.32);
\node[lbl] at (11.30, 6.46) {32b (addr/wdata $\cdot$ valid $\cdot$ wstrb)};

\draw[sig] (16.30, 5.575) -- (16.30, 5.90) -- (19.80, 5.90) -- (19.80, 7.425);
\node[lbl] at (18.05, 5.72) {mem\_ready};

\draw[sig] (21.60, 5.575) -- (21.60, 7.425);
\draw[tick] (21.51, 6.30) -- (21.69, 6.54);
\node[lbl] at (22.65, 6.42) {32b (mem\_rdata)};

\draw[sig] (addr_dec.east) -- (bus_ctrl.west);
\node[lbl] at (11.40, 5.15) {*\_sel};

\draw[sig] (bus_ctrl.east) -- (rdata_mux.west);
\draw[tick] (17.17, 4.78) -- (17.35, 5.02);
\node[lbl] at (17.26, 5.20) {32b};

% ==============================================================================
% 4. Nivel F: Memoria y Periféricos MMIO (Verde)
% ==============================================================================
\node[blk, fill=green!42, minimum width=5.40cm, minimum height=1.40cm]
  (leds_blk) at (8.35, 2.48)
  {\textbf{leds (GPIO MMIO)}\\\scriptsize leds[14:0] (15b Reg R/W)\\\scriptsize Dir: 0x1000\_0000};

\node[blk, fill=green!42, minimum width=5.10cm, minimum height=1.40cm]
  (uart_blk) at (14.30, 2.48)
  {\textbf{simpleuart (115200 bps)}\\\scriptsize cfg\_divider (0x2000\_0004)\\\scriptsize RX/TX Data (0x2000\_0008)};

\node[blk, fill=green!42, minimum width=5.15cm, minimum height=1.40cm]
  (bram_blk) at (20.25, 2.48)
  {\textbf{bram\_sp (BRAM Unificada $\cdot$ 16 KB)}\\\scriptsize 4096$\times$32b (4$\times$RAMB36E1) $\cdot$ wstrb[3:0]\\\scriptsize 0x0000\_0000--3FFF $\cdot$ 1-cyc Sync Read};

% Conexiones Nivel E <-> Nivel F (rutas disjuntas, sin cruces)
\draw[bisig] (12.20, 4.225) -- (12.20, 3.70) -- (8.35, 3.70) -- (leds_blk.north);
\draw[tick] (10.16, 3.58) -- (10.34, 3.82);
\node[lbl] at (10.25, 3.96) {15b};

\draw[sig] (13.80, 4.225) -- (13.80, 3.18);
\node[lbl] at (13.10, 3.70) {we/re/di};
\draw[sig] (15.10, 3.18) -- (15.10, 4.225);
\node[lbl] at (15.78, 3.70) {do/wait};

\draw[sig] (16.55, 4.225) -- (16.55, 3.70) -- (19.00, 3.70) -- (19.00, 3.18);
\draw[tick] (17.71, 3.58) -- (17.89, 3.82);
\node[lbl] at (17.80, 3.96) {en $\cdot$ addr $\cdot$ wdata};

\draw[sig] (21.55, 3.18) -- (21.55, 4.225);
\draw[tick] (21.46, 3.58) -- (21.64, 3.82);
\node[lbl] at (22.65, 3.70) {32b (ram\_rdata)};

% ==============================================================================
% 5. Nivel G: Pines Físicos Nexys A7-100T y Precarga de Firmware (Gris)
% ==============================================================================
\node[blk, fill=gray!35, minimum width=5.10cm, minimum height=0.84cm]
  (pins_leds) at (8.35, 0.75)
  {\textbf{LEDs Usuario [14:0]}\\\scriptsize Nexys A7 Pins H17--V12};

\node[blk, fill=gray!35, minimum width=5.10cm, minimum height=0.84cm]
  (pins_uart) at (14.30, 0.75)
  {\textbf{USB-UART FT2232HQ}\\\scriptsize ser\_tx (D4) \quad|\quad ser\_rx (C4)};

\node[blk, fill=gray!35, minimum width=5.15cm, minimum height=0.84cm]
  (fw_init) at (20.25, 0.75)
  {\textbf{build/firmware.hex}\\\scriptsize \$readmemh (Bootloader / Counter)};

\draw[sig] (leds_blk.south) -- (pins_leds.north);
\draw[tick] (8.26, 1.36) -- (8.44, 1.60);
\node[lbl] at (8.85, 1.48) {15b};

\draw[sig] (13.30, 1.78) -- (13.30, 1.17);
\node[lbl] at (12.65, 1.48) {ser\_tx};
\draw[sig] (15.30, 1.17) -- (15.30, 1.78);
\node[lbl] at (15.95, 1.48) {ser\_rx};

\draw[sig, dashed] (fw_init.north) -- (bram_blk.south);
\node[lbl] at (20.68, 1.48) {Init};

