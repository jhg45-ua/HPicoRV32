\begin{tikzpicture}[
  >= {Stealth[length=2.3mm, width=1.65mm]},
  blk/.style={
    draw=black,
    line width=1.05pt,
    rounded corners=4.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=3pt
  },
  subblk/.style={
    draw=black,
    line width=0.95pt,
    rounded corners=3.5pt,
    align=center,
    text=black,
    font=\footnotesize,
    inner xsep=4pt,
    inner ysep=2.5pt
  },
  container/.style={
    draw=black,
    line width=1.2pt,
    rounded corners=6.5pt,
    inner sep=0pt
  },
  swatch/.style={
    draw=black,
    line width=0.75pt,
    rounded corners=1.5pt,
    inner sep=0pt,
    minimum width=0.38cm,
    minimum height=0.24cm
  },
  sig/.style={
    ->,
    draw=black,
    line width=0.95pt
  },
  bisig/.style={
    <->,
    draw=black,
    line width=0.95pt
  },
  tick/.style={
    draw=black,
    line width=0.95pt
  },
  lbl/.style={
    font=\scriptsize\bfseries,
    text=black,
    inner sep=1.5pt
  }
]

% ==============================================================================
% 0. Cabecera
% ==============================================================================
%\node[font=\normalsize\bfseries] at (2.10, 18.00)
  %{\textcolor{red!70!black}{HPicoRV32} - 2026};
\node[font=\huge\bfseries] at (12.45, 17.95)
  {HPicoRV32};
%\node[font=\normalsize\bfseries] at (12.45, 17.30)
  %{Hardened PicoRV32};
%\node[font=\normalsize\bfseries] at (22.80, 18.00)
  %{Nexys A7-100T $\cdot$ xc7a100t};

% ==============================================================================
% 1. Columna Izquierda: Clock & POR + Trap + Leyenda / Métricas
% ==============================================================================

% --- Contenedor Clock & Power-On Reset (soc.v) ---
\node[container, fill=violet!32, minimum width=4.20cm, minimum height=5.75cm]
  (clk_por_box) at (2.10, 13.525) {};
\node[font=\small\bfseries] at (2.10, 16.00)
  {Clock \& POR (soc.v)};

\node[subblk, fill=violet!18, minimum width=3.60cm, minimum height=0.90cm]
  (clk_in) at (2.10, 15.05)
  {\textbf{clk (100 MHz)}\\\scriptsize Nexys A7 Pin E3};

\node[subblk, fill=violet!18, minimum width=3.60cm, minimum height=0.90cm]
  (rst_in) at (2.10, 13.85)
  {\textbf{resetn (CPU\_RESETN)}\\\scriptsize Pin C12 $\cdot$ Activo bajo};

\node[subblk, fill=violet!18, minimum width=3.60cm, minimum height=0.95cm]
  (por_cnt) at (2.10, 12.60)
  {\textbf{POR Counter}\\\scriptsize reset\_cnt[5:0] (63 ciclos)};

\node[subblk, fill=violet!18, minimum width=3.60cm, minimum height=0.90cm]
  (sys_rst) at (2.10, 11.35)
  {\textbf{sys\_resetn}\\\scriptsize = \&reset\_cnt};

\draw[sig] (rst_in.south) -- (por_cnt.north);
\draw[sig] (por_cnt.south) -- (sys_rst.north);

% --- Indicador de Trampa (LED15) ---
\node[blk, fill=gray!35, minimum width=4.20cm, minimum height=1.65cm]
  (trap_blk) at (2.10, 8.15)
  {\textbf{Trap Indicator (LED15)}\\\fontsize{6.3}{7.8}\selectfont cpu\_trap | harv\_fault\_r | ecc\_fault\_r\\\fontsize{6.3}{7.8}\selectfont ILLINSN $\cdot$ MISALIGN $\cdot$ W\^{}X\\\fontsize{6.3}{7.8}\selectfont Reg / Mem DBE};

% --- Leyenda de Niveles ---
\node[container, fill=gray!10, minimum width=4.20cm, minimum height=3.80cm]
  (leyenda_box) at (2.10, 3.68) {};
\node[font=\footnotesize\bfseries] at (2.10, 5.22)
  {Leyenda};
\draw[line width=0.6pt, gray!60] (0.24, 4.95) -- (3.96, 4.95);

\node[swatch, fill=violet!32] (sw_fe) at (0.44, 4.54) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 4.54) {Front-End $\cdot$ POR};

\node[swatch, fill=orange!62] (sw_dec) at (0.44, 4.08) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 4.08) {Decode $\cdot$ CSRs $\cdot$ W\^{}X};

\node[swatch, fill=yellow!35] (sw_bus) at (0.44, 3.62) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 3.62) {Regfile $\cdot$ SoC Bus};

\node[swatch, fill=blue!28] (sw_exec) at (0.44, 3.16) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 3.16) {Execution $\cdot$ Native Mem IF};

\node[swatch, fill=green!42] (sw_mem) at (0.44, 2.70) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 2.70) {BRAM $\cdot$ Periféricos};

\node[swatch, fill=gray!35] (sw_io) at (0.44, 2.24) {};
\node[font=\scriptsize\bfseries, text width=3.20cm, align=left] at (2.40, 2.24) {I/O Física $\cdot$ Backend / Init};

% ==============================================================================
% 2. Núcleo PicoRV32 (rtl/core/picorv32.v)
% ==============================================================================
\node[container, fill=gray!8, minimum width=19.20cm, minimum height=9.65cm]
  (core_box) at (15.30, 11.575) {};
\node[font=\small] at (15.30, 16.08)
  {\textbf{Core: picorv32} \scriptsize (RV32I $\cdot$ \textcolor{red!70!black}{\textbf{[TMR]}} = 3$\times$FF \texttt{\_r0..2} + \texttt{tmr\_voter} 2-of-3 + 1-Cyc Self-Healing $\cdot$ Regfile ECC $\cdot$ rtl/core/picorv32.v)};

% --- Nivel A: Front-End & Control (Morado) ---
\node[blk, fill=violet!32, minimum width=5.15cm, minimum height=1.20cm]
  (pc_unit) at (8.75, 14.50)
  {\textbf{Program Counter}\\\scriptsize reg\_pc[31:0] $\cdot$ reg\_next\_pc[31:0] \textcolor{red!70!black}{\textbf{[TMR]}}};

\node[blk, fill=violet!32, minimum width=5.10cm, minimum height=1.20cm]
  (fetch_unit) at (15.00, 14.50)
  {\textbf{Instruction Fetch / Latch}\\\scriptsize mem\_rdata\_latched $\cdot$ mem\_do\_rinst\\\scriptsize latched\_rd[4:0] \textcolor{red!70!black}{\textbf{[TMR]}}};

\node[blk, fill=violet!32, minimum width=5.25cm, minimum height=1.20cm]
  (ctrl_fsm) at (20.95, 14.50)
  {\textbf{Control FSM}\\\scriptsize cpu\_state[7:0] \textcolor{red!70!black}{\textbf{[TMR]}}\\\scriptsize fetch $\cdot$ ld\_rs1/2 $\cdot$ exec $\cdot$ mem $\cdot$ trap};

% --- Nivel B: Decode & Counters (Naranja) ---
\node[blk, fill=orange!62, minimum width=10.10cm, minimum height=1.20cm]
  (decoder) at (11.20, 12.60)
  {\textbf{RV32I Instruction \& CSR Decoder}\\\scriptsize instr\_* $\cdot$ CATCH\_ILLINSN=1 $\cdot$ CATCH\_MISALIGN=1\\\scriptsize CSR 0xCC0--0xCC3 $\cdot$ reg\_uses\_rs1/2};

\node[blk, fill=orange!62, minimum width=6.25cm, minimum height=1.20cm]
  (counters) at (20.45, 12.60)
  {\textbf{Hardware \& Fault CSRs (32b R/O)}\\\scriptsize cycle/instr $\cdot$ tmr\_pc/ctrl (0xCC0/1)\\\scriptsize ecc\_reg\_sbu/dbu (0xCC2/3)};

% --- Nivel C: Register File & Operands (Amarillo) ---
\node[blk, fill=yellow!35, minimum width=10.10cm, minimum height=1.25cm]
  (regfile) at (11.20, 10.60)
  {\textbf{Register File + Hsiao SEC-DED (39,32)}\\\scriptsize cpuregs[0:31] $\cdot$ 32$\times$39b LUTRAM (14$\times$RAM32M)\\\scriptsize 1-Cyc Auto-Scrubbing $\cdot$ reg\_dbe\_event $\rightarrow$ trap};

\node[blk, fill=yellow!35, minimum width=6.25cm, minimum height=1.25cm]
  (op_regs) at (20.45, 10.60)
  {\textbf{Operand \& Writeback Regs}\\\scriptsize reg\_op1 $\cdot$ reg\_op2 $\cdot$ reg\_out (32b)};

% --- Nivel D: Execution & Memory Interface (Azul) ---
\node[blk, fill=blue!28, minimum width=5.40cm, minimum height=1.35cm]
  (alu) at (8.85, 8.10)
  {\textbf{ALU (Combinational)}\\\scriptsize ADD/SUB $\cdot$ Logic $\cdot$ Compare\\\scriptsize alu\_out $\rightarrow$ alu\_out\_q (32b)};

\node[blk, fill=blue!28, minimum width=5.10cm, minimum height=1.35cm]
  (shifter) at (15.00, 8.10)
  {\textbf{Barrel Shifter (1-Cycle)}\\\scriptsize SLL $\cdot$ SRL $\cdot$ SRA (32b)\\\scriptsize BARREL\_SHIFTER=1};

\node[blk, fill=blue!28, minimum width=5.25cm, minimum height=1.35cm]
  (mem_if) at (20.95, 8.10)
  {\textbf{Native Memory Interface}\\\scriptsize mem\_state[1:0] \textcolor{red!70!black}{\textbf{[TMR]}} $\cdot$ Valid/Ready\\\scriptsize mem\_valid $\cdot$ mem\_instr $\cdot$ mem\_wstrb};

% --- Conexiones internas de picorv32 ---
\draw[bisig] (pc_unit.east) -- (fetch_unit.west);
\draw[sig] (fetch_unit.east) -- (ctrl_fsm.west);

\draw[sig] (13.70, 13.90) -- (13.70, 13.20);
\draw[tick] (13.61, 13.43) -- (13.79, 13.67);
\node[lbl] at (14.55, 13.55) {32b (insn)};

\draw[sig] (20.95, 13.90) -- (20.95, 13.20);
\node[lbl] at (22.00, 13.55) {tmr/ecc\_err};

\draw[sig] (decoder.south) -- (regfile.north);
\draw[tick] (11.11, 11.49) -- (11.29, 11.73);
\node[lbl] at (12.35, 11.61) {5b (rs1/rs2/rd)};

\draw[sig] (counters.south) -- (op_regs.north);
\draw[tick] (20.36, 11.49) -- (20.54, 11.73);
\node[lbl] at (20.95, 11.61) {32b};

\draw[sig] (regfile.east) -- (op_regs.west);
\draw[tick] (16.70, 10.48) -- (16.88, 10.72);
\node[lbl] at (16.79, 10.95) {2$\times$32b};

% Operandos -> ALU y Barrel Shifter
\draw[sig] (18.60, 9.975) -- (18.60, 9.38) -- (10.35, 9.38) -- (10.35, 8.775);
\draw[sig] (15.00, 9.38) -- (shifter.north);
\fill[black] (15.00, 9.38) circle (0.055);
\draw[tick] (16.71, 9.26) -- (16.89, 9.50);
\node[lbl] at (16.80, 9.68) {32b (reg\_op1/2)};

% Shifter -> ALU y ALU writeback -> Regfile
\draw[sig] (shifter.west) -- (alu.east);
\draw[sig] (7.60, 8.775) -- (7.60, 9.975);
\draw[tick] (7.51, 9.26) -- (7.69, 9.50);
\node[lbl] at (6.80, 9.38) {32b (wb)};

% Operandos / Carga <-> Interfaz de memoria
\draw[sig] (20.15, 9.975) -- (20.15, 8.775);
\draw[tick] (20.06, 9.26) -- (20.24, 9.50);
\node[lbl] at (19.60, 9.38) {32b};

\draw[sig] (22.25, 8.775) -- (22.25, 9.975);
\draw[tick] (22.16, 9.26) -- (22.34, 9.50);
\node[lbl] at (22.80, 9.38) {32b};

% Retorno de instrucción capturada (mem_instr) hacia Fetch
\draw[sig] (mem_if.east) -- (24.40, 8.10) -- (24.40, 15.52) -- (15.00, 15.52) -- (fetch_unit.north);
\draw[tick] (24.31, 11.68) -- (24.49, 11.92);
\node[lbl] at (24.00, 11.80) {32b};
\node[lbl] at (19.70, 15.72) {mem\_rdata (mem\_instr=1)};

% --- Conexiones Core <-> Columna Izquierda ---
\draw[sig] (4.20, 14.85) -- (5.70, 14.85);
\node[lbl] at (4.95, 15.08) {clk};

\draw[sig] (4.20, 11.35) -- (5.70, 11.35);
\node[lbl] at (4.95, 11.58) {sys\_resetn};

\draw[sig] (5.70, 8.15) -- (trap_blk.east);
\node[lbl] at (4.95, 8.38) {cpu\_trap};

% ==============================================================================
% 3. Nivel E: Bus Nativo Harvard SoC y Decodificador de Direcciones (soc.v)
% ==============================================================================
\node[blk, fill=orange!62, minimum width=5.30cm, minimum height=1.35cm]
  (addr_dec) at (8.80, 4.90)
  {\textbf{Harvard Address Decoder (Comb.)}\\\fontsize{6.5}{8.0}\selectfont imem: 0x0000--1FFF $\cdot$ dmem: 2000--3FFF\\\fontsize{6.5}{8.0}\selectfont W\^{}X (harv\_err) $\cdot$ leds/uart/ecc (0x1/2/3000\_*)};

\node[blk, fill=yellow!35, minimum width=5.20cm, minimum height=1.35cm]
  (bus_ctrl) at (14.85, 4.90)
  {\textbf{MMIO \& ECC Telemetry Ctrl (Sync.)}\\\fontsize{6.5}{8.0}\selectfont bus\_ready\_r $\cdot$ harv\_fault\_r $\cdot$ ecc\_fault\_r\\\fontsize{6.5}{8.0}\selectfont count\_ecc\_imem/dmem\_sbu/dbu (0x3000\_*)};

\node[blk, fill=yellow!18, minimum width=5.40cm, minimum height=1.35cm]
  (rdata_mux) at (20.95, 4.90)
  {\textbf{Harvard Mem Interface \& Read Mux}\\\fontsize{6.5}{8.0}\selectfont mem\_ready = imem | dmem | bus\_ready\_r\\\fontsize{6.5}{8.0}\selectfont mem\_rdata = imem / dmem / mmio\_rdata};

% Conexiones Core <-> Nivel E (sin cruces)
\draw[sig] (18.60, 7.425) -- (18.60, 6.20) -- (8.80, 6.20) -- (addr_dec.north);
\draw[sig] (14.85, 6.20) -- (bus_ctrl.north);
\fill[black] (14.85, 6.20) circle (0.055);
\draw[sig] (18.60, 6.20) -- (18.60, 5.575);
\fill[black] (18.60, 6.20) circle (0.055);
\draw[tick] (11.735, 6.08) -- (11.915, 6.32);
\node[lbl] at (11.825, 6.46) {32b (addr/wdata $\cdot$ valid $\cdot$ wstrb $\cdot$ instr)};

\draw[sig] (20.55, 5.575) -- (20.55, 7.425);
\node[lbl] at (19.65, 6.50) {mem\_ready};

\draw[sig] (22.45, 5.575) -- (22.45, 7.425);
\draw[tick] (22.36, 6.38) -- (22.54, 6.62);
\node[lbl] at (23.70, 6.50) {32b (mem\_rdata)};

\draw[sig] (addr_dec.east) -- (bus_ctrl.west);
\node[lbl] at (11.85, 5.15) {*\_sel};

\draw[sig] (bus_ctrl.east) -- (rdata_mux.west);
\draw[tick] (17.76, 4.78) -- (17.94, 5.02);
\node[lbl] at (17.85, 5.20) {32b};

% ==============================================================================
% 4. Nivel F: Memorias Harvard bram_ecc y Periféricos MMIO (Verde)
% ==============================================================================
\node[blk, fill=green!42, minimum width=3.70cm, minimum height=1.40cm]
  (leds_blk) at (8.00, 2.48)
  {\textbf{leds (GPIO MMIO)}\\\scriptsize leds[14:0] (15b Reg R/W)\\\scriptsize Dir: 0x1000\_0000};

\node[blk, fill=green!42, minimum width=4.00cm, minimum height=1.40cm]
  (uart_blk) at (12.15, 2.48)
  {\textbf{simpleuart (115200 bps)}\\\scriptsize cfg\_divider (0x2000\_0004)\\\scriptsize RX/TX Data (0x2000\_0008)};

\node[blk, fill=green!42, minimum width=4.45cm, minimum height=1.40cm]
  (imem_blk) at (16.675, 2.48)
  {\textbf{imem: bram\_ecc (8 KB $\cdot$ RO)}\\\scriptsize 2048$\times$39b Hsiao SEC-DED\\\scriptsize 0x0000\_0000--1FFF $\cdot$ Scrub (2/3c)};

\node[blk, fill=green!42, minimum width=4.45cm, minimum height=1.40cm]
  (dmem_blk) at (21.425, 2.48)
  {\textbf{dmem: bram\_ecc (8 KB $\cdot$ R/W)}\\\scriptsize 2048$\times$39b Hsiao / Vivado Soft ECC IP\\\scriptsize 0x0000\_2000--3FFF $\cdot$ RMW \& Scrub};

% Conexiones Nivel E <-> Nivel F (rutas disjuntas, sin cruces)
\draw[bisig] (12.60, 4.225) -- (12.60, 3.72) -- (8.00, 3.72) -- (leds_blk.north);
\draw[tick] (10.21, 3.60) -- (10.39, 3.84);
